@page "/jobs"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IJobService JobService

<PageTitle>Jobs</PageTitle>

<PageHeader Title="Jobs" Subtitle="Track active and closed construction jobs with budget snapshots." />

@if (loading)
{
    <LoadingState Message="Loading jobs..." ShowSkeleton="false" />
}
else if (jobs.Count == 0)
{
    <EmptyState Title="No jobs yet" Description="Approve an estimate and create a job to begin tracking costs.">
        <Actions><a href="/estimates" class="btn-primary">View Estimates</a></Actions>
    </EmptyState>
}
else
{
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @foreach (var job in jobs)
        {
            <a href="@($"/jobs/{job.JobId}")" class="card group block transition hover:shadow-card hover:ring-2 hover:ring-brand-500/20">
                <div class="card-body">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <div class="text-xs font-semibold uppercase tracking-wide text-brand-600">@job.JobNumber</div>
                            <h3 class="mt-1 text-lg font-semibold text-slate-900 group-hover:text-brand-700">@job.JobName</h3>
                            <p class="mt-1 text-sm text-slate-500">From @job.EstimateNumber</p>
                        </div>
                        <StatusBadge Status="@job.Status" />
                    </div>
                    <div class="mt-4 flex items-center text-sm font-medium text-brand-600">
                        Open job
                        <svg class="ml-1 h-4 w-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                </div>
            </a>
        }
    </div>
}

@code {
    private IReadOnlyList<Job> jobs = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        jobs = await JobService.GetAllAsync();
        loading = false;
    }
}
